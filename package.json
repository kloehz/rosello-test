{
  "name": "grupo-rossello-static-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run css && npm run copy",
    "clean": "node scripts/clean-dist.js",
    "css": "tailwindcss -c tailwind.config.cjs -i ./src/styles.css -o ./assets/styles.css --minify",
    "copy": "node scripts/copy-dist.js",
    "preview": "npx http-server dist -c-1",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.10",
    "tailwindcss": "3.4.17",
    "http-server": "14.1.1"
  }
}
